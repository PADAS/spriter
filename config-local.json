{
  "mode": {
    "symbol": {
      "sprite": "../event-svg-sprite.svg",
      "render": {
        "css": false
      }
    }
  },
  "dest": ".",
  "shape": {
    "transform": [
      {
        "svgo": {
          "plugins": [
            "preset-default",
            {
              "name": "removeStyleElement",
              "active": true
            },
            {
              "name": "removeAttrs",
              "params": {
                "attrs": "(class|style|fill|stroke)"
              }
            }
          ]
        }
      }
    ]
  }
}
